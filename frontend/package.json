{
  "name": "finsight-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FinSight browser UI: streaming agent trace, cited answers, evidence ledger.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
